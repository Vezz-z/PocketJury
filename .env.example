# ==============================================================================
# PocketJury Environment Configuration
# Copy this file to .env and fill in all values before running
# ==============================================================================

# ---- Database ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pocketjury
POSTGRES_USER=pocketjury
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ---- Redis ----
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ---- Authentication ----
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- Passwordless Auth ----
# MAGIC_LINK_BASE_URL=http://localhost:3000  # Base URL for magic links (optional, defaults to FRONTEND_URL)
# VALIDATE_MX_RECORDS=false                  # Enable MX record validation for email domains
# OTP_TTL_SECONDS=600                        # OTP validity: 10 minutes
# MAGIC_LINK_TTL_MINUTES=15                  # Magic link validity: 15 minutes

# ---- AI Service ----
AI_SERVICE_URL=http://ai:8000

# LLM Provider — currently using OpenRouter (see MIGRATE_API.md to switch providers)
# Get your free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_MODEL_ID=openai/gpt-oss-120b # nvidia/nemotron-3-ultra-550b-a55b:free
# Optional: Use a different, faster model strictly for chat title generation
# TITLE_LLM_MODEL_ID=google/gemma-4-31b-it:free

# For local Ollama: uncomment below, comment out OPENROUTER_API_KEY above (see LLM.md)
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL_ID=llama3.1:8b

GOOGLE_TRANSLATE_API_KEY=
LEGAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large
QUERY_EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu # cuda for GPU

# ---- Encryption ----
ENCRYPTION_KEY=

# ---- Monitoring ----
SENTRY_DSN=

# ---- Application ----
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DOMAIN=localhost
LOG_LEVEL=debug

# ---- Email Transport (choose one option) ----
# Leave all blank to use console logging (default for dev).
#
# Option A: Gmail SMTP via Nodemailer (recommended for testing)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=pocketjuryai@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop   # 16-char App Password (not your Gmail password)
# SMTP_FROM=PocketJury <pocketjuryai@gmail.com>
#
# Option B: Resend (recommended for production)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=PocketJury <noreply@yourdomain.com>
