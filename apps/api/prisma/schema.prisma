// ==============================================================================
// PocketJury Database Schema — PostgreSQL 16 + pgvector 0.8.1
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pgcrypto]
}

// ---- Enums ----

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum PersonaMode {
  STUDENT
  PROFESSIONAL
  SENIOR_CITIZEN
  RURAL_USER
  GENERAL
}

enum ProfessionType {
  STUDENT
  EMPLOYED
  UNEMPLOYED
  SELF_EMPLOYED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum DocumentType {
  STATUTE
  JUDGMENT
  CONSTITUTION
  AMENDMENT
  NOTIFICATION
  RULE
}

enum ConsentType {
  DATA_PROCESSING
  LOCATION
  ANALYTICS
  COMMUNICATION
}

enum EscalationAuthorityType {
  DLSA
  SLSA
  NALSA
  HELPLINE
}

enum HelplineCategory {
  WOMEN
  CHILD
  EMERGENCY
  LEGAL_AID
  CYBERCRIME
  SENIOR
  SC_ST
  TRAFFICKING
}

enum FeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum IPCBNSMappingType {
  DIRECT
  MERGED
  SPLIT
  NEW
  DROPPED
}

enum TextDirection {
  LTR
  RTL
}

// ---- Models ----

model User {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String       @unique
  emailHash         String       @unique @map("email_hash")
  passwordHash      String?      @map("password_hash")
  authProvider      AuthProvider @default(EMAIL) @map("auth_provider")
  googleId          String?      @unique @map("google_id")
  preferredLanguage String       @default("en") @map("preferred_language") @db.VarChar(5)
  role              UserRole     @default(USER)
  isVerified        Boolean      @default(false) @map("is_verified")
  isActive          Boolean      @default(true) @map("is_active")
  lastLoginAt       DateTime?    @map("last_login_at") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz

  profile    Profile?
  chats      Chat[]
  feedback   Feedback[]
  auditLogs  AuditLog[]
  consents   UserConsent[]
  language   Language         @relation(fields: [preferredLanguage], references: [code])

  @@index([authProvider])
  @@index([isActive])
  @@map("users")
}

model Profile {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String          @unique @map("user_id") @db.Uuid
  fullName          String          @map("full_name")
  dateOfBirth       String          @map("date_of_birth")
  contactPhone      String?         @map("contact_phone")
  professionType    ProfessionType? @map("profession_type")
  fieldOfStudy      String?         @map("field_of_study")
  yearOfPassing     Int?            @map("year_of_passing")
  currentProfession String?         @map("current_profession")
  personaMode       PersonaMode     @default(GENERAL) @map("persona_mode")
  locationState     String?         @map("location_state")
  locationDistrict  String?         @map("location_district")
  profileCompleted  Boolean         @default(false) @map("profile_completed")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Language {
  code        String        @id @db.VarChar(5)
  nameEnglish String        @map("name_english")
  nameNative  String        @map("name_native")
  script      String
  isActive    Boolean       @default(true) @map("is_active")
  direction   TextDirection @default(LTR)

  users User[]
  chats Chat[]

  @@map("languages")
}

model Chat {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  title        String      @default("New Chat")
  personaMode  PersonaMode @default(GENERAL) @map("persona_mode")
  languageCode String      @default("en") @map("language_code") @db.VarChar(5)
  isArchived   Boolean     @default(false) @map("is_archived")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language   @relation(fields: [languageCode], references: [code])
  messages Message[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, isArchived])
  @@map("chats")
}

model Message {
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId                  String      @map("chat_id") @db.Uuid
  role                    MessageRole
  content                 String
  contentOriginalLanguage String?     @map("content_original_language")
  languageCode            String      @default("en") @map("language_code") @db.VarChar(5)
  metadata                Json?       @db.JsonB
  simplifiedContent       String?     @map("simplified_content")
  isFlagged               Boolean     @default(false) @map("is_flagged")
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz

  chat     Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  feedback Feedback[]

  @@index([chatId, createdAt])
  @@map("messages")
}

model LegalDocument {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentType    DocumentType @map("document_type")
  title           String
  actName         String?      @map("act_name")
  sectionNumber   String?      @map("section_number")
  chapter         String?
  part            String?
  schedule        String?
  bodyText        String       @map("body_text")
  sourceUrl       String       @unique @map("source_url")
  sourceName      String       @map("source_name")
  effectiveFrom   DateTime     @map("effective_from") @db.Date
  effectiveUntil  DateTime?    @map("effective_until") @db.Date
  isRepealed      Boolean      @default(false) @map("is_repealed")
  replacedById    String?      @map("replaced_by_id") @db.Uuid
  year            Int
  amendmentNumber String?      @map("amendment_number")
  metadata        Json?        @db.JsonB
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  replacedBy  LegalDocument?      @relation("ReplacementChain", fields: [replacedById], references: [id])
  replaces    LegalDocument[]     @relation("ReplacementChain")
  embeddings  DocumentEmbedding[]

  @@index([actName, sectionNumber])
  @@index([documentType])
  @@index([effectiveFrom])
  @@index([isRepealed])
  @@map("legal_documents")
}

model DocumentEmbedding {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  chunkIndex     Int      @map("chunk_index")
  chunkText      String   @map("chunk_text")
  chunkTokens    Int      @map("chunk_tokens")
  embeddingModel String   @map("embedding_model")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_embeddings")
}

model IPCBNSMapping {
  id          Int               @id @default(autoincrement())
  ipcSection  String            @map("ipc_section")
  bnsSection  String            @map("bns_section")
  description String
  mappingType IPCBNSMappingType @map("mapping_type")

  @@unique([ipcSection, bnsSection])
  @@index([ipcSection])
  @@index([bnsSection])
  @@map("ipc_bns_mapping")
}

model EscalationContact {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state         String
  district      String
  authorityName String                  @map("authority_name")
  authorityType EscalationAuthorityType @map("authority_type")
  address       String
  phone         String
  email         String?
  website       String?
  latitude      Decimal?                @db.Decimal(10, 7)
  longitude     Decimal?                @db.Decimal(10, 7)
  isActive      Boolean                 @default(true) @map("is_active")

  @@unique([state, district])
  @@index([state, district])
  @@index([authorityType])
  @@map("escalation_contacts")
}

model Helpline {
  id          Int              @id @default(autoincrement())
  name        String
  number      String           @unique
  description String
  category    HelplineCategory
  isNational  Boolean          @default(true) @map("is_national")

  @@map("helplines")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Feedback {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String         @map("message_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  rating    FeedbackRating
  comment   String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("feedback")
}

model UserConsent {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  consentType    ConsentType @map("consent_type")
  granted        Boolean
  grantedAt      DateTime    @map("granted_at") @db.Timestamptz
  revokedAt      DateTime?   @map("revoked_at") @db.Timestamptz
  ipAddress      String?     @map("ip_address")
  consentVersion String      @default("1.0") @map("consent_version")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
  @@map("user_consents")
}
