  "legal": {
    "terms": {
      "title": "পরিষেবার শর্তাবলী",
      "lastUpdated": "শেষ আপডেট: ২০২৪",
      "intro": "PocketJury তে স্বাগতম। আমাদের অ্যাপ্লিকেশন অ্যাক্সেস বা ব্যবহার করে, আপনি এই পরিষেবার শর্তাবলীতে আবদ্ধ হতে সম্মত হচ্ছেন।",
      "sections": {
        "1": {
          "heading": "১. পরিষেবার প্রকৃতি",
          "content": "PocketJury হল একটি কৃত্রিম বুদ্ধিমত্তা চালিত শিক্ষামূলক সরঞ্জাম যা ভারতীয় নাগরিকদের জন্য অ্যাক্সেসযোগ্য আইনি তথ্য প্রদানের জন্য ডিজাইন করা হয়েছে। PocketJury কোনো আইনি সংস্থা নয়, এবং এর থেকে প্রাপ্ত তথ্য আইনি পরামর্শ নয়। নির্দিষ্ট আইনি উদ্বেগের জন্য আপনাকে একজন যোগ্য আইনি পেশাদারের সাথে পরামর্শ করতে হবে।"
        },
        "2": {
          "heading": "২. ব্যবহারকারীর দায়িত্ব",
          "content": "আপনি PocketJury শুধুমাত্র আইনী উদ্দেশ্যে ব্যবহার করতে সম্মত হন। আপনি কীভাবে অপরাধ করতে হয়, আইন থেকে বাঁচতে হয় বা ক্ষতি করতে হয় তার পরামর্শ পেতে এই পরিষেবাটি ব্যবহার করবেন না।"
        },
        "3": {
          "heading": "৩. পরিষেবা পরিবর্তন",
          "content": "আমরা কোনো পূর্ব বিজ্ঞপ্তি ছাড়াই যেকোনো সময় পরিষেবা পরিবর্তন বা বন্ধ করার অধিকার সংরক্ষণ করি।"
        }
      }
    },
