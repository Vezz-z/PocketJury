  "legal": {
    "terms": {
      "title": "सेवा की शर्तें",
      "lastUpdated": "अंतिम अपडेट: 2024",
      "intro": "PocketJury में आपका स्वागत है। हमारे एप्लिकेशन को एक्सेस या उपयोग करके, आप इन सेवा की शर्तों से बाध्य होने के लिए सहमत हैं।",
      "sections": {
        "1": {
          "heading": "1. सेवा की प्रकृति",
          "content": "PocketJury एक आर्टिफिशियल इंटेलिजेंस द्वारा संचालित शैक्षणिक उपकरण है जिसे भारतीय नागरिकों को सुलभ कानूनी जानकारी प्रदान करने के लिए डिज़ाइन किया गया है। PocketJury कोई लॉ फर्म नहीं है, और उत्पन्न जानकारी कानूनी सलाह नहीं है। किसी भी विशिष्ट कानूनी चिंता के लिए आपको एक योग्य कानूनी पेशेवर से परामर्श करना चाहिए।"
        },
        "2": {
          "heading": "2. उपयोगकर्ता की जिम्मेदारियाँ",
          "content": "आप PocketJury का उपयोग केवल वैध उद्देश्यों के लिए करने के लिए सहमत हैं। आपको सेवा का उपयोग अपराध करने, कानून प्रवर्तन से बचने या शारीरिक नुकसान पहुंचाने के तरीके पर सलाह उत्पन्न करने के लिए नहीं करना चाहिए। प्रदान की गई जानकारी की व्याख्या करने और उस पर कार्रवाई करने के लिए आप पूरी तरह से जिम्मेदार हैं।"
        },
        "3": {
          "heading": "3. सेवा में संशोधन",
          "content": "हम आपको बिना किसी सूचना के किसी भी समय सेवा को संशोधित करने या बंद करने का अधिकार सुरक्षित रखते हैं। सेवा के किसी भी संशोधन या बंदी के लिए हम आपके या किसी तीसरे पक्ष के प्रति उत्तरदायी नहीं होंगे।"
        }
      }
    },
    "privacy": {
      "title": "गोपनीयता नीति",
      "lastUpdated": "अंतिम अपडेट: 2024",
      "intro": "PocketJury पर, आपकी गोपनीयता हमारी प्राथमिकता है, विशेष रूप से कानूनी पूछताछ की संवेदनशील प्रकृति को देखते हुए।",
      "sections": {
        "1": {
          "heading": "1. स्थानीय LLM आर्किटेक्चर",
          "content": "PocketJury को Ollama के माध्यम से पूरी तरह से स्थानीयकृत लार्ज लैंग्वेज मॉडल (LLMs) का समर्थन करने के लिए डिज़ाइन किया गया है। जब ऑफ़लाइन मोड में चलाया जाता है, तो कोई भी चैट ट्रांसक्रिप्ट या व्यक्तिगत प्रश्न आपके भौतिक उपकरण से बाहर नहीं जाता है।"
        },
        "2": {
          "heading": "2. डेटा संग्रह",
          "content": "जब क्लाउड-आधारित प्रदाताओं (जैसे OpenRouter) का उपयोग करते हैं, तो आपके प्रश्न केवल उत्तर उत्पन्न करने के उद्देश्य से TLS पर सुरक्षित रूप से प्रेषित किए जाते हैं। हम आपका व्यक्तिगत डेटा या पूछताछ इतिहास तीसरे पक्ष को नहीं बेचते हैं।"
        },
        "3": {
          "heading": "3. ऑनबोर्डिंग डेटा",
          "content": "प्रतिसाद को निजीकृत करने के लिए आपकी ऑनबोर्डिंग प्राथमिकताएं (स्थान, व्यवसाय, शिक्षा स्तर) सत्र भंडारण का उपयोग करके स्थानीय रूप से संग्रहीत की जाती हैं। यह डेटा विज्ञापन के लिए एकत्र नहीं किया जाता है।"
        }
      }
    },
